{
  "name": "@watchtowerobservability/cordova",
  "version": "0.1.0",
  "repository": { "type": "git", "url": "git+https://github.com/watchtowerobservability/watchtower-cordova.git" },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "description": "Watchtower for Apache Cordova apps: browser SDK in the webview with Cordova lifecycle, plus native iOS and Android SDKs",
  "type": "module",
  "packageManager": "pnpm@11.2.2",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" }
  },
  "files": ["dist", "plugin.xml", "Package.swift", "src/ios", "src/android"],
  "license": "Apache-2.0",
  "engines": { "node": ">=18" },
  "cordova": { "id": "watchtower-cordova", "platforms": ["ios", "android"] },
  "keywords": ["ecosystem:cordova", "cordova-ios", "cordova-android"],
  "peerDependencies": {
    "@watchtowerobservability/browser": ">=0.1.0"
  },
  "scripts": {
    "prebuild": "node scripts/browser-src.mjs",
    "build": "node esbuild.config.mjs && tsgo -p tsconfig.build.json",
    "typecheck": "tsgo --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "esbuild": "0.25.10",
    "vitest": "5.0.5"
  }
}
